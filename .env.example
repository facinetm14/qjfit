DATABASE_URL=postgresql://QJFit:password@db:5432/QJFit

POSTGRES_USER=QJFit
POSTGRES_PASSWORD=password
POSTGRES_DB=QJFit

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://qjfit.tech

# France travail API configuration
FRANCE_TRAVAIL_BASE_URL=https://api.francetravail.io/partenaire/offresdemploi/v2
FRANCE_TRAVAIL_AUTH_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

FRANCE_TRAVAIL_PAGE_SIZE=150

# WTTJ RSS feed URL. Left blank, that source's fetch fails and is logged to
WTTJ_RSS_FEED_URL=

REDIS_URL=redis://redis:6379

# AI matching pipeline
SCORING_CANDIDATE_LIMIT=50
SCORING_DECAY_DAYS=14
ROLE_SIMILARITY_THRESHOLD=0.25
SCORING_BATCH_SIZE=50

# ScoringProviderPort adapter (ADR 0020) — interim free provider via
# OpenRouter, ahead of a later paid Claude-backed adapter. minimax/minimax-m3:free
# was OpenRouter's original free slug; it was discontinued (404s on the free
# tier) — nvidia/nemotron-3-super-120b-a12b:free replaced it (see ADR 0020).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

VITE_API_URL=
