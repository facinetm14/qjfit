DATABASE_URL=postgresql://QJFit:password@db:5432/QJFit

# Read directly by the postgres image in docker-compose.prod.yml's `db`
# service (env_file passthrough) — must stay consistent with the
# credentials embedded in DATABASE_URL above. docker-compose.yml (dev)
# hardcodes these instead; only the prod compose file needs them from .env.
POSTGRES_USER=QJFit
POSTGRES_PASSWORD=password
POSTGRES_DB=QJFit

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://qjfit.tech

VITE_API_URL=
