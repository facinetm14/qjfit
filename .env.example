DATABASE_URL=postgresql://QJFit:password@db:5432/QJFit

# Read directly by the postgres image in docker-compose.prod.yml's `db`
# service (env_file passthrough) — must stay consistent with the
# credentials embedded in DATABASE_URL above. docker-compose.yml (dev)
# hardcodes these instead; only the prod compose file needs them from .env.
POSTGRES_USER=QJFit
POSTGRES_PASSWORD=password
POSTGRES_DB=QJFit

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://qjfit.tech

# Cron expression driving the in-process job pool refresh (ADR 0016 §3).
# Defaults to every 4 hours when unset.
FETCH_RUN_CRON_SCHEDULE=0 */4 * * *

# France Travail connector credentials. Left blank, that source's fetch
# fails and is logged to fetch_logs for that run; the other source still runs.
FRANCE_TRAVAIL_BASE_URL=
FRANCE_TRAVAIL_ACCESS_TOKEN=

# WTTJ RSS feed URL. Left blank, that source's fetch fails and is logged to
# fetch_logs for that run; the other source still runs.
WTTJ_RSS_FEED_URL=

VITE_API_URL=
