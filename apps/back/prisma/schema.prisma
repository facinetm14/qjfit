generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  CDI
  CDD
  Freelance
  Internship
  Apprenticeship
  Other
}

enum RemotePolicy {
  Full
  Hybrid
  OnSite
  Unknown
}

enum RunStatus {
  pending
  running
  completed
  failed
}

model Job {
  id             String       @id @default(cuid())
  title          String
  company        String
  location       String
  contractType   ContractType
  remotePolicy   RemotePolicy
  description    String
  url            String
  source         String
  sourceJobId    String?
  dedupKey       String
  salaryMin      Int?
  salaryMax      Int?
  experienceMin  Int?
  experienceMax  Int?
  fetchedAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([source, sourceJobId])
  @@index([dedupKey])
  @@index([fetchedAt])
  @@map("jobs")
}

model FetchRun {
  id         String    @id @default(cuid())
  status     RunStatus @default(pending)
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  logs       FetchLog[]

  @@index([createdAt])
  @@map("fetch_runs")
}

model FetchLog {
  id        String   @id @default(cuid())
  runId     String
  source    String
  status    String
  message   String?
  fetched   Int      @default(0)
  createdAt DateTime @default(now())
  run       FetchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, source])
  @@map("fetch_logs")
}
