generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  CDI
  CDD
  Freelance
  Internship
  Apprenticeship
  Other
}

enum RemotePolicy {
  Full
  Hybrid
  OnSite
  Unknown
}

enum RunStatus {
  pending
  running
  completed
  failed
}

model Job {
  id             String       @id @default(cuid())
  title          String
  company        String
  location       String
  contractType   ContractType
  remotePolicy   RemotePolicy
  description    String
  url            String
  source         String
  sourceJobId    String?
  dedupKey       String
  salaryMin      Int?
  salaryMax      Int?
  experienceMin  Int?
  experienceMax  Int?
  fetchedAt      DateTime     @db.Timestamptz
  createdAt      DateTime     @default(now()) @db.Timestamptz
  updatedAt      DateTime     @updatedAt @db.Timestamptz

  @@unique([source, sourceJobId])
  @@index([dedupKey])
  @@index([fetchedAt])
  @@map("jobs")
}

model FetchRun {
  id         String    @id @default(cuid())
  status     RunStatus @default(pending)
  startedAt  DateTime? @db.Timestamptz
  endedAt    DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @updatedAt @db.Timestamptz
  logs       FetchLog[]

  @@index([createdAt])
  @@map("fetch_runs")
}

model FetchLog {
  id        String   @id @default(cuid())
  runId     String
  source    String
  status    String
  message   String?
  fetched   Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz
  run       FetchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, source])
  @@map("fetch_logs")
}
