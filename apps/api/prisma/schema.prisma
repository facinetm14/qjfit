generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ContractType {
  CDI
  CDD
  Freelance
  Internship
  Apprenticeship
  Other
}

enum RemotePolicy {
  Full
  Hybrid
  OnSite
  Unknown
}

enum JobStatus {
  new
  scored
  score_failed
}

enum RunStatus {
  pending
  running
  completed
  failed
}

model Profile {
  id                     String   @id @default(cuid())
  targetRole             String
  targetCompanyIndustry  String[]
  techStack              String[]
  seniorityMin           Int
  seniorityMax           Int
  location               String
  excludedKeywords       String[]
  contractTypes          ContractType[]
  salaryMin              Int?
  bio                    String?
  availability           DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("profile")
}

model Job {
  id             String       @id @default(cuid())
  title          String
  company        String
  location       String
  contractType   ContractType
  remotePolicy   RemotePolicy
  description    String
  url            String
  source         String
  sourceJobId    String?
  dedupKey       String
  salaryMin      Int?
  salaryMax      Int?
  experienceMin  Int?
  experienceMax  Int?
  status         JobStatus    @default(new)
  fetchedAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  score          Score?

  @@unique([source, sourceJobId])
  @@index([dedupKey])
  @@index([status, fetchedAt])
  @@map("jobs")
}

model Score {
  id            String   @id @default(cuid())
  jobId         String   @unique
  score         Int
  summary       String
  matchReasons  String[]
  missingSkills String[]
  seniorityFit  String
  redFlags      String[]
  rawResponse   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([score])
  @@map("scores")
}

model FetchRun {
  id         String    @id @default(cuid())
  status     RunStatus @default(pending)
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  logs       FetchLog[]

  @@index([createdAt])
  @@map("fetch_runs")
}

model FetchLog {
  id        String   @id @default(cuid())
  runId     String
  source    String
  status    String
  message   String?
  fetched   Int      @default(0)
  createdAt DateTime @default(now())
  run       FetchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, source])
  @@map("fetch_logs")
}
