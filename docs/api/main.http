@baseUrl = http://localhost:3000
@contentType = application/json

### Health
GET {{baseUrl}}/health

### Match - Upload a CV (PDF or DOCX, 5MB max)
# Returns 202 with an opaque ticket id. Rate-limited to 2 requests/IP/day
# (429 with a resetAt timestamp once exceeded); parses the CV in memory and
# never persists it — see ADR 0016 §2, §4.
POST {{baseUrl}}/api/match
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="cv"; filename="cv.pdf"
Content-Type: application/pdf

< ./fixtures/cv.pdf
------boundary--

### Match - Poll a match ticket
# Does not count against the rate limit. 404 once the ticket's short TTL
# (minutes) has expired or it never existed.
@ticketId = replace-with-a-real-ticket-id
GET {{baseUrl}}/api/match/{{ticketId}}
